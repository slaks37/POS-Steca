# ---------------------------------------------------------------------------
# Kredensial penandatanganan rilis Android.
#
# Salin menjadi `android/keystore.properties` lalu isi sesuai keystore Anda.
# BERKAS ASLINYA JANGAN PERNAH DI-COMMIT — sudah masuk .gitignore. Kehilangan
# keystore berarti Anda tidak bisa lagi merilis pembaruan untuk aplikasi yang
# sama di Play Store, jadi cadangkan di tempat aman.
#
# Membuat keystore (lihat README bagian Android untuk langkah lengkapnya):
#   keytool -genkey -v -keystore steca-pos-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias steca-pos
# ---------------------------------------------------------------------------

# Path keystore, relatif terhadap folder android/app/ atau absolut.
storeFile=../steca-pos-release.jks
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE
keyAlias=steca-pos
keyPassword=GANTI_DENGAN_PASSWORD_KEY
