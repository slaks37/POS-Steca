# ---------------------------------------------------------------------------
# Konfigurasi build Android (Capacitor).
# Salin menjadi `.env.android`, lalu jalankan `npm run build:android`.
#
# WAJIB berupa URL PENUH yang bisa dijangkau perangkat Android. WebView
# berjalan pada origin https://localhost, sehingga "localhost" di dalam
# aplikasi menunjuk ke ponsel itu sendiri — bukan ke komputer pengembang.
#
#   Salah : /api/v1
#   Salah : http://localhost:8080/api/v1
#   Benar : https://api.tokoanda.com/api/v1
#
# Untuk uji coba di jaringan lokal, pakai alamat IP komputer pengembang
# (contoh: http://192.168.1.10:8080/api/v1) dan pastikan CORS_ORIGINS pada
# backend mengizinkan origin https://localhost.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.tokoanda.com/api/v1
