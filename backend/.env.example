# ---------------------------------------------------------------------------
# Konfigurasi backend POS Steca. Salin menjadi .env lalu sesuaikan.
# ---------------------------------------------------------------------------

# Port HTTP backend.
PORT=8080

# development | production. Mode production mematikan endpoint demo dan
# mengaktifkan release mode Gin.
APP_ENV=development

# postgres : datastore produksi (sumber kebenaran). Gambar produk tetap
#            disimpan di folder Google Drive milik pemilik akun.
# google   : datastore lama berbasis Google Sheets. Masih didukung dan menjadi
#            dasar fitur sinkronisasi opsional pada tahap berikutnya.
# memory   : datastore in-memory untuk pengembangan lokal dan mode demo,
#            tanpa kredensial maupun database. Data hilang saat proses berhenti.
POS_DATASTORE=postgres

# --- PostgreSQL (wajib saat POS_DATASTORE=postgres) ---
# Development lokal memakai docker-compose.yml di root repositori:
#   docker compose up -d
DATABASE_URL=postgres://pos:pos@localhost:5432/pos_steca?sslmode=disable

# Migrasi skema dijalankan otomatis saat aplikasi start. Setel false bila
# migrasi dijalankan terpisah pada pipeline deployment.
RUN_MIGRATIONS=true

# URL frontend, dipakai untuk redirect setelah OAuth dan whitelist CORS.
FRONTEND_URL=http://localhost:5173

# Daftar origin yang diizinkan CORS, dipisah koma. Default mengikuti FRONTEND_URL.
# CORS_ORIGINS=http://localhost:5173,https://pos.tokoanda.com

# --- Google OAuth2 (wajib saat POS_DATASTORE=google) ---
# Buat OAuth Client ID bertipe "Web application" di Google Cloud Console,
# aktifkan Google Drive API dan Google Sheets API, lalu daftarkan redirect URI
# di bawah ini pada "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- Keamanan ---
# Kunci penandatangan JWT sesi aplikasi. Gunakan nilai acak panjang.
# Contoh membuat: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# Kunci enkripsi refresh token Google (AES-256-GCM), baik yang tersimpan di
# berkas (mode google) maupun di kolom tenants.refresh_token_enc (mode postgres).
# Wajib saat POS_DATASTORE=postgres atau google. Mengganti kunci ini membuat token lama
# tidak bisa dibaca dan semua pemilik harus menghubungkan ulang akun Google.
ENCRYPTION_KEY=

# --- Lain-lain ---
# Direktori penyimpanan daftar tenant (tenants.json). Hanya dipakai pada
# POS_DATASTORE=google; pada mode postgres data tenant ada di tabel tenants.
DATA_DIR=./data

# Umur cache katalog produk agar hemat kuota Google Sheets API.
# Hanya berlaku pada POS_DATASTORE=google.
SHEETS_CACHE_TTL=20s

# Zona waktu aplikasi: nama IANA ("Asia/Jakarta") atau offset menit ("420").
APP_TIMEZONE=420
